    given-names: Honglin
  - family-names: Zhou
    given-names: Bolei
repository-code: "https://github.com/VAIL-UCLA/visnavkit"
license: MIT
keywords:
  - visual-navigation
  - robot-learning
  - imitation-learning
  - diffusion-policy
  - flow-matching
  - onnx
date-released: "2026-09-14"
